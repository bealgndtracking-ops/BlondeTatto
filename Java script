let currentGallery = "";

// Función para abrir la galería
function openGallery(galleryId) {
    const data = galleriesData[galleryId];
    if (!data) return;

    currentGallery = galleryId;
    
    // Rellenar textos
    galleryTitle.textContent = data.title;
    galleryDesc.textContent = data.desc;

    // Rellenar fotos
    galleryImages.innerHTML = ""; // Limpia las anteriores
    data.images.forEach(src => {
        const img = document.createElement("img");
        img.src = src;
        img.alt = data.title;
        galleryImages.appendChild(img);
    });

    // Ocultar inicio, mostrar galería
    homeView.classList.add("hidden");
    galleryView.classList.remove("hidden");
    
    // Subir arriba de la pantalla
    window.scrollTo(0, 0);
}

// Al hacer clic en una especialidad
galleryLinks.forEach(link => {
    link.addEventListener('click', (e) => {
        e.preventDefault();
        const galleryId = link.getAttribute('data-gallery');
        openGallery(galleryId);
    });
});

// Botón de Volver al Inicio
btnBack.addEventListener('click', () => {
    galleryView.classList.add("hidden");
    homeView.classList.remove("hidden");
    window.scrollTo(0, 0);
});

// Botón de Siguiente
btnNext.addEventListener('click', () => {
    const nextGallery = galleriesData[currentGallery].next;
    openGallery(nextGallery);
});

